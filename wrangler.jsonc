{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "url-shortner",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "LINKS",
      "id": "a0c2156c071b43979b871c4305f7fb8b"
    }
  ],
  "routes": [
    {
      "pattern": "go.hellojyp.com",
      "custom_domain": true
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "2026102019",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "GUEST_RATE_LIMITER",
      "namespace_id": "2026102020",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SETUP_GATE",
        "class_name": "SetupGate"
      },
      {
        "name": "GUEST_QUOTA",
        "class_name": "GuestQuota"
      },
      {
        "name": "CODE_ALLOCATOR",
        "class_name": "CodeAllocator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SetupGate",
        "GuestQuota"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "CodeAllocator"
      ]
    }
  ]
}
