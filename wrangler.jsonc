{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "url-shortner",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "LINKS", "id": "a0c2156c071b43979b871c4305f7fb8b" }
  ]
}
